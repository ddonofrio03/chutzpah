---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HolidayExpiry from '../components/HolidayExpiry.astro';
import site from '../data/site.json';
import { fullAddress } from '../lib/hours';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Breakfast, lunch, dinner and catering from a REAL New York deli at Fairfax Towne Center since 2001. Order online for pickup or stop in, 7 days a week.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Structured data so Google shows hours, phone and address correctly.
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.name,
  url: Astro.site?.toString(),
  telephone: site.phone,
  servesCuisine: ['Deli', 'Jewish', 'New York'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days.map((d) => dayNames[d]),
    opens: h.open.padStart(5, '0'),
    closes: h.close.padStart(5, '0'),
  })),
  hasMenu: new URL('/our-menu/', Astro.site).toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content="#1b1916" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta name="geo.placename" content={fullAddress} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <HolidayExpiry />
    <style>
      .skip {
        position: absolute;
        left: 12px;
        top: -60px;
        z-index: 50;
        padding: 10px 14px;
        background: var(--mustard);
        color: var(--rye);
        font-weight: 700;
      }
      .skip:focus {
        top: 12px;
      }
    </style>
  </body>
</html>
