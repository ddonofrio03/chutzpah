---
/*
  The holiday menu page. Eric uploads the menu (PDF or picture) on /update/ and flips it on;
  this page shows it. When nothing is on, visitors see a short "between holidays" note.
*/
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Holiday Menu | Chutzpah Deli, Fairfax VA" description="Chutzpah Deli holiday catering menus for Rosh Hashanah, Yom Kippur break fast, Passover and more." bodyPage="holiday">
  <div data-holiday hidden>
    <section class="page-head">
      <div class="wrap">
        <span class="kicker">Holiday Menu</span>
        <h1 data-h="title"></h1>
        <p class="note" data-h="note" hidden></p>
        <div class="btn-row btns">
          <a class="btn btn-red" href={site.phoneHref}>Order: {site.phone}</a>
          <a class="btn btn-light" data-h-file href="#" target="_blank" rel="noopener">Open the menu full size</a>
        </div>
      </div>
    </section>
    <div class="wrap body">
      <div class="viewer" data-h-viewer></div>
    </div>
  </div>

  <section class="page-head" data-holiday-off>
    <div class="wrap">
      <span class="kicker">Holiday Menu</span>
      <h1>Between holidays</h1>
      <p>
        Our holiday menus go up before Rosh Hashanah, Yom Kippur and Passover. Planning something now? Call {site.phone} and ask for
        Eric, or see the catering menu.
      </p>
      <div class="btn-row btns">
        <a class="btn btn-red" href="/catering/">See the Catering Menu</a>
        <a class="btn btn-light" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  [hidden] {
    display: none !important;
  }
  .note {
    white-space: pre-line;
  }
  .btns {
    margin-top: 24px;
  }
  .body {
    padding-block: clamp(32px, 5vw, 64px);
  }
  .viewer {
    max-width: 960px;
    margin-inline: auto;
  }
  .viewer :global(img) {
    width: 100%;
    background: #fff;
    box-shadow: var(--shadow);
  }
  .viewer.is-pdf :global(iframe) {
    display: block;
    width: 100%;
    height: min(1200px, 85vh);
    border: 1px solid var(--grout);
    background: #fff;
  }
</style>
