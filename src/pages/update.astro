---
/*
  Eric's page for posting the daily special from his phone.
  Not linked anywhere on the site and hidden from search engines; posting needs the PIN.
*/
import Base from '../layouts/Base.astro';
import Letterboard from '../components/Letterboard.astro';
import site from '../data/site.json';

const labels = ["Today's Special", 'Breakfast Special', 'Lunch Special', 'Dinner Special', 'Weekend Special'];
---

<Base title="Post the Special | Chutzpah Deli" noindex>
  <section class="wrap page">
    <header class="top">
      <h1 class="display">Post the Special</h1>
      <p>Type it in and tap <strong>Post to website</strong>. It shows on the home page within a minute.</p>
    </header>

    <div class="grid">
      <form id="special-form" class="form" novalidate>
        <label class="field">
          Which special
          <select name="label">
            {labels.map((l) => <option value={l}>{l}</option>)}
          </select>
        </label>
        <label class="field">
          Name of the special
          <input name="title" maxlength="80" placeholder="BBQ Chicken Poutine" autocomplete="off" />
        </label>
        <label class="field">
          Description <span class="opt">(optional)</span>
          <textarea name="description" maxlength="300" rows="3" placeholder="Hand cut fries, pepper jack, pulled BBQ chicken, cole slaw"></textarea>
        </label>
        <label class="field">
          Price <span class="opt">(optional)</span>
          <input name="price" maxlength="30" placeholder="$15" inputmode="text" autocomplete="off" />
        </label>

        <label class="toggle">
          <input type="checkbox" name="show" checked />
          <span>Show the special on the website</span>
        </label>

        <label class="field pin">
          PIN
          <input name="pin" type="password" inputmode="numeric" autocomplete="current-password" maxlength="12" />
        </label>
        <label class="toggle small">
          <input type="checkbox" name="remember" checked />
          <span>Remember the PIN on this phone</span>
        </label>

        <button type="submit" class="btn btn-red post">Post to website</button>
        <button type="button" class="btn btn-line" id="take-down">Take the special down</button>

        <p class="status" role="status" aria-live="polite"></p>
      </form>

      <div class="preview">
        <p class="preview-label">How it will look</p>
        <Letterboard label={site.special.label} title={site.special.title} description={site.special.description} price={site.special.price} />
        <p class="hint">Last posted: <span id="last">loading…</span></p>
        <a href="/" class="view">View the home page</a>
      </div>
    </div>
  </section>
</Base>

<script>
  type Special = { show: boolean; label: string; title: string; description: string; price: string; updatedAt?: string };

  const form = document.getElementById('special-form') as HTMLFormElement;
  const status = form.querySelector<HTMLElement>('.status')!;
  const last = document.getElementById('last')!;
  const board = document.querySelector<HTMLElement>('.preview .board')!;
  const f = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const PIN_KEY = 'chutzpah-update-pin';

  // Mirror the form into the letterboard preview as he types.
  function preview() {
    const vals: Record<string, string> = {
      label: f('label').value,
      title: f('title').value,
      description: f('description').value,
      price: f('price').value,
    };
    Object.entries(vals).forEach(([k, v]) => {
      const el = board.querySelector<HTMLElement>(`[data-f="${k}"]`);
      if (!el) return;
      el.textContent = v;
      el.hidden = !v;
    });
    board.style.opacity = f('show').checked ? '1' : '0.35';
  }

  function fill(s: Special) {
    f('label').value = s.label;
    f('title').value = s.title;
    f('description').value = s.description;
    f('price').value = s.price;
    f('show').checked = s.show;
    preview();
  }

  function when(iso?: string) {
    if (!iso) return 'not yet';
    return new Date(iso).toLocaleString('en-US', {
      timeZone: 'America/New_York',
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    });
  }

  try {
    const saved = localStorage.getItem(PIN_KEY);
    if (saved) f('pin').value = saved;
  } catch {}

  // Start from what's on the site now.
  fetch('/api/special/', { cache: 'no-store' })
    .then((r) => (r.ok ? (r.json() as Promise<Special>) : null))
    .then((s) => {
      if (s) {
        fill(s);
        last.textContent = when(s.updatedAt);
      } else {
        preview();
        last.textContent = 'nothing posted yet (the site shows the default special)';
      }
    })
    .catch(() => {
      preview();
      last.textContent = 'could not check';
    });

  form.addEventListener('input', preview);

  async function send(show: boolean) {
    status.className = 'status';
    status.textContent = 'Posting…';
    const pin = f('pin').value.trim();
    if (!pin) {
      status.className = 'status error';
      status.textContent = 'Enter the PIN first.';
      f('pin').focus();
      return;
    }
    const body = {
      pin,
      show,
      label: f('label').value,
      title: f('title').value,
      description: f('description').value,
      price: f('price').value,
    };
    try {
      const r = await fetch('/api/special/', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || 'Something went wrong. Try again.');
      try {
        if ((f('remember') as HTMLInputElement).checked) localStorage.setItem(PIN_KEY, pin);
        else localStorage.removeItem(PIN_KEY);
      } catch {}
      fill(data.special);
      last.textContent = when(data.special.updatedAt);
      status.className = 'status ok';
      status.textContent = show
        ? 'Posted. It will be on the home page within a minute.'
        : 'Taken down. The letterboard is hidden on the home page.';
    } catch (e) {
      status.className = 'status error';
      status.textContent = (e as Error).message;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    send(f('show').checked);
  });
  document.getElementById('take-down')!.addEventListener('click', () => {
    f('show').checked = false;
    preview();
    send(false);
  });
</script>

<style>
  .page {
    padding-block: clamp(28px, 5vw, 64px) 80px;
  }
  .top h1 {
    font-size: clamp(32px, 5vw, 52px);
  }
  .top p {
    margin-top: 10px;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    margin-top: 28px;
    align-items: start;
  }
  .form {
    display: grid;
    gap: 16px;
  }
  .opt {
    font-weight: 400;
    color: var(--muted);
  }
  .field select {
    font: 600 16px var(--body);
    min-height: 48px;
    padding: 0 12px;
    border: 2px solid var(--grout);
    border-radius: var(--radius);
    background: #fff;
  }
  .toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-weight: 600;
  }
  .toggle input {
    width: 24px;
    height: 24px;
    accent-color: var(--pastrami);
  }
  .toggle.small {
    font-weight: 500;
    font-size: 15px;
    color: var(--muted);
    margin-top: -8px;
  }
  .pin {
    padding-top: 12px;
    border-top: 1px solid var(--grout);
  }
  .pin input {
    max-width: 200px;
    letter-spacing: 0.2em;
  }
  .post {
    min-height: 56px;
    font-size: 18px;
  }
  .status {
    min-height: 1.5em;
    font-weight: 700;
  }
  .status.ok {
    color: #2b7a3f;
  }
  .status.error {
    color: var(--pastrami);
  }
  .preview {
    position: sticky;
    top: 104px;
  }
  .preview-label {
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .preview :global(.board) {
    transition: opacity 0.2s;
  }
  .hint {
    margin-top: 14px;
    font-size: 15px;
    color: var(--muted);
  }
  .view {
    display: inline-block;
    margin-top: 6px;
    font-weight: 700;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .preview {
      position: static;
      order: -1;
    }
  }
</style>
