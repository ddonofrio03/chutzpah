---
/*
  The catering-by-occasion pages (shiva catering, breakfast catering, etc.).
  Each one is a Markdown file in src/content/catering/. The file name is the URL,
  so these keep the same addresses they had on the old site.
*/
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

export async function getStaticPaths() {
  const files = import.meta.glob<{ frontmatter: { title: string }; Content: any }>('../content/catering/*.md', {
    eager: true,
  });
  return Object.entries(files).map(([path, mod]) => ({
    params: { occasion: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { title: mod.frontmatter.title, Content: mod.Content },
  }));
}

const { title, Content } = Astro.props;
---

<Base title={`${title} | Chutzpah Deli`} description={`${title} from Chutzpah Deli, a REAL New York deli and caterer in Fairfax VA. Call Eric at ${site.phone}.`}>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker"><a href="/catering/">Catering</a></span>
      <h1 class="occ-title">{title}</h1>
    </div>
  </section>

  <div class="wrap layout">
    <article class="prose">
      <Content />
    </article>
    <aside class="card">
      <h2 class="display">Order catering</h2>
      <p>Call the store and ask for Eric.</p>
      <a class="btn btn-red" href={site.phoneHref}>{site.phone}</a>
      <p class="small">Fax {site.fax}<br />{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</p>
      <a class="btn btn-line" href="/catering/">See the Catering Menu</a>
    </aside>
  </div>
</Base>

<style>
  .page-head .kicker a {
    color: inherit;
  }
  .occ-title {
    font-size: clamp(34px, 5.6vw, 68px) !important;
    max-width: 18ch;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(32px, 6vw, 80px);
    padding-block: clamp(48px, 6vw, 80px);
    align-items: start;
  }
  .card {
    position: sticky;
    top: 104px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px;
    background: #fff;
    border: 1px solid var(--grout);
    border-top: 4px solid var(--pastrami);
  }
  .card h2 {
    font-size: 24px;
  }
  .small {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .card {
      position: static;
    }
  }
</style>
