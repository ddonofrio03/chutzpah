---
import Base from '../layouts/Base.astro';
import MenuSection from '../components/MenuSection.astro';
import site from '../data/site.json';
import menu from '../data/menu.json';
import HolidayBanner from '../components/HolidayBanner.astro';
import { activeHoliday, holidayUntil } from '../lib/holiday';
---

<Base
  title="Our Menu | Chutzpah Deli, Fairfax VA"
  description="The full Chutzpah Deli menu: breakfast, soups, overstuffed sandwiches, the 40 oz. Reuben, burgers, entrees, desserts and the kids menu."
>
  <section class="page-head">
    <div class="wrap">
      <span class="kicker">Chutzpah Deli · Full Menu</span>
      <h1>{menu.cover.line1}</h1>
      <p>{menu.cover.line2}. Of course pickles and cole slaw are free with the purchase of a sandwich or entrée.</p>
      <div class="btn-row head-btns">
        <a class="btn btn-red" href={site.orderUrl}>Order Online</a>
        <a class="btn btn-light" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </section>

  <HolidayBanner compact />

  <nav class="cats" aria-label="Menu sections">
    <div class="wrap cats-inner">
      {
        activeHoliday && (
          <a href="/holidaymenu/" class="holiday-tab" data-holiday-until={holidayUntil || undefined}>
            {activeHoliday.name} Menu
          </a>
        )
      }
      {menu.categories.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
    </div>
  </nav>

  <div class="wrap menu">
    {
      menu.categories.map((c) => (
        <section id={c.id} class="cat" aria-labelledby={`${c.id}-h`}>
          <header class="cat-head">
            <h2 id={`${c.id}-h`} class="display">
              {c.title}
            </h2>
            {c.intro && <p>{c.intro}</p>}
          </header>
          <div class="cols">
            {c.sections.map((s) => (
              <MenuSection section={s} tone={!s.title || s.title === 'SPECIAL' || s.items.length === 1 ? 'boxed' : 'plain'} />
            ))}
          </div>
          {c.outro?.map((t) => <p class="outro">{t}</p>)}
        </section>
      ))
    }

    <aside class="fine-print">
      <p>{menu.advisory}</p>
      <p>{menu.coldSmoked}</p>
      <p>Menu edition: {menu.edition}. Prices and items subject to change. <a href="/about-us/#rules">Read our 6 simple rules</a>.</p>
    </aside>
  </div>
</Base>

<script>
  // Highlight the menu tab for the section on screen.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.cats a').forEach((a) => links.set(a.hash.slice(1), a));
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        const a = links.get(e.target.id);
        if (a) {
          a.setAttribute('aria-current', 'true');
          a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      });
    },
    { rootMargin: '-140px 0px -70% 0px' },
  );
  document.querySelectorAll('.cat').forEach((s) => io.observe(s));
</script>

<style>
  .head-btns {
    margin-top: 28px;
  }
  .cats {
    position: sticky;
    top: 79px;
    z-index: 10;
    background: var(--tile);
    border-bottom: 1px solid var(--grout);
  }
  .cats-inner {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-block: 10px;
    scrollbar-width: none;
  }
  .cats-inner::-webkit-scrollbar {
    display: none;
  }
  .cats a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 99px;
    border: 1px solid var(--grout);
    background: #fff;
    color: var(--rye);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
  }
  .cats a:hover {
    border-color: var(--rye);
  }
  .cats a.holiday-tab {
    background: var(--mustard);
    border-color: var(--mustard);
    color: var(--rye);
    font-weight: 700;
  }
  .cats a[aria-current='true'] {
    background: var(--rye);
    border-color: var(--rye);
    color: #fff;
  }

  .menu {
    padding-bottom: 80px;
  }
  .cat {
    padding-top: clamp(48px, 6vw, 72px);
    scroll-margin-top: 140px;
  }
  .cat-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding-bottom: 16px;
    margin-bottom: 28px;
    border-bottom: 4px solid var(--rye);
  }
  .cat-head h2 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 0.95;
  }
  .cat-head p {
    font-weight: 600;
    color: var(--pastrami);
  }
  .cols {
    columns: 2 420px;
    column-gap: clamp(32px, 5vw, 64px);
  }
  .cols > :global(*) {
    margin-bottom: 36px;
  }
  .outro {
    font-weight: 600;
    color: var(--muted);
  }
  .fine-print {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--grout);
    display: grid;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 1020px) {
    .cats {
      top: 79px;
    }
  }
</style>
