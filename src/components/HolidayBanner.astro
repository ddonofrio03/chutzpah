---
// Holiday banner for the home page and menu page. Hidden until Eric switches a holiday menu on.
import site from '../data/site.json';
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class:list={['holiday', { compact }]} data-holiday hidden aria-label="Holiday menu">
  <div class="wrap inner">
    <div class="copy">
      <span class="tag">Now taking <span data-h="name"></span> orders</span>
      <h2 class="display" data-h="title"></h2>
      <p class="note" data-h="note" hidden></p>
    </div>
    <div class="btn-row">
      <a class="btn btn-mustard" href="/holidaymenu/">See the <span data-h="name"></span> Menu</a>
      <a class="btn btn-light" href={site.phoneHref}>Order: {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .holiday {
    background: var(--rye);
    color: #fff;
    border-bottom: 4px solid var(--mustard);
    /* a row of order "tickets" along the top, like the rail over a deli counter */
    background-image: repeating-linear-gradient(90deg, var(--mustard) 0 18px, transparent 18px 30px);
    background-size: 100% 6px;
    background-repeat: no-repeat;
  }
  .holiday[hidden] {
    display: none;
  }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px 40px;
    align-items: center;
    padding-block: clamp(30px, 4vw, 44px);
  }
  .compact .inner {
    padding-block: 22px;
  }
  .tag {
    display: inline-block;
    padding: 4px 10px;
    background: var(--pastrami);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h2 {
    margin-top: 12px;
    font-size: clamp(24px, 3.2vw, 38px);
    line-height: 1.05;
  }
  .compact h2 {
    font-size: clamp(20px, 2.4vw, 28px);
  }
  .note {
    margin-top: 10px;
    max-width: 70ch;
    font-size: 16px;
    color: #d9d4ca;
  }
  .note[hidden] {
    display: none;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
